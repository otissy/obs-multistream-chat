{
  "adapter": 1,
  "platform": "twitch",
  "experimental": false,
  "title": "Twitch popout chat",
  "note": "Selectors cross-checked by reading Social Stream Ninja's sources/twitch.js (GPL-3.0, see NOTICE); not verified against a live page by the author.",
  "url": "https://www.twitch.tv/popout/{target}/chat",
  "hosts": ["www.twitch.tv"],
  "loginPaths": ["/login", "/signup"],
  "containerTimeoutSec": 45,
  "engine": {
    "container": [".chat-scrollable-area__message-container", ".chat-list--other", ".chat-list--default", ".chat-room__content"],
    "item": [".chat-line__message"],
    "ignore": [".user-notice-line", ".chat-line__message--deleted-notice", ".chat-line__status"],
    "id": { "attrs": ["data-mid"] },
    "author": { "sel": [".chat-author__display-name", ".chatter-name"], "color": "inline" },
    "body": { "sel": ["[data-a-target='chat-line-message-body']", "[data-test-selector='chat-line-message-body']", ".message"] },
    "emote": { "sel": ["img.chat-image", "img.chat-line__message--emote"], "name": ["alt"], "src": ["src"] },
    "badge": { "sel": ["img.chat-badge"], "name": ["alt", "aria-label"] },
    "login": { "sel": ["[data-a-target='login-button']"], "text": ["log in to continue", "this content is not available"] }
  }
}
