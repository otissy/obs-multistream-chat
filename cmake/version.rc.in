#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @OMS_VER_COMMA@
 PRODUCTVERSION @OMS_VER_COMMA@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @OMS_FILETYPE@
 FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "otissy (production-suite)"
      VALUE "FileDescription", "@OMS_DESCRIPTION@"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "@OMS_INTERNAL@"
      VALUE "LegalCopyright", "GPL-2.0-or-later"
      VALUE "OriginalFilename", "@OMS_INTERNAL@@OMS_EXT@"
      VALUE "ProductName", "OBS Multistream Chat"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
